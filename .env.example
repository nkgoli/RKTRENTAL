# Keep all credentials on the server. Example values below cannot send messages.
DATABASE_URL=postgresql://rocketrental:rocketrental@localhost:5432/rocketrental?schema=public
ROCKETRENTAL_SANDBOX=true
REMINDERS_LIVE_ENABLED=false

# Connected EMAIL/smtp row: settings={"credentialPrefix":"RR_REMINDER_EXAMPLE_EMAIL"}
RR_REMINDER_EXAMPLE_EMAIL_SMTP_HOST=smtp.example.invalid
RR_REMINDER_EXAMPLE_EMAIL_SMTP_PORT=587
RR_REMINDER_EXAMPLE_EMAIL_SMTP_USER=
RR_REMINDER_EXAMPLE_EMAIL_SMTP_PASSWORD=
RR_REMINDER_EXAMPLE_EMAIL_SMTP_FROM=manager@example.invalid

# Connected SMS/twilio row: settings={"credentialPrefix":"RR_REMINDER_EXAMPLE_SMS"}
RR_REMINDER_EXAMPLE_SMS_TWILIO_ACCOUNT_SID=
RR_REMINDER_EXAMPLE_SMS_TWILIO_AUTH_TOKEN=
RR_REMINDER_EXAMPLE_SMS_TWILIO_FROM=
REMINDERS_TWILIO_CALLBACK_URL=https://example.invalid/api/webhooks/notifications/twilio
