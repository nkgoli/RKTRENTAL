# RocketRental environment -- copy to `.env` (`cp .env.example .env`).
# Every value below is a local/sandbox placeholder. Never commit a real
# secret, and never put a live provider key in this file.

# --- Database (required) ---------------------------------------------------
# Local embedded Postgres (npm run db:local / npm run preview):
DATABASE_URL="postgresql://rocketrental:rocketrental@localhost:5432/rocketrental?schema=public"
# Port for the embedded Postgres when 5432 is taken (keep it in sync above):
ROCKETRENTAL_DB_PORT=5432

# --- App -------------------------------------------------------------------
PORT=3000
# Signs session cookies. Use a long random value outside local dev:
ROCKETRENTAL_AUTH_SECRET="change-me-local-dev-only-secret"
# Explicitly enable built-in mock providers and signing for local demos.
ROCKETRENTAL_SANDBOX=true
# Local HTTP only; production cookies remain Secure by default.
ROCKETRENTAL_AUTH_COOKIE_SECURE=false
# Set to 1 only to intentionally create the demo accounts outside dev:
SEED_DEMO_PASSWORDS=

# --- Providers: sandbox only by default ------------------------------------
# With no keys set, payments, screening, comps and email all use the built-in
# mock/sandbox adapters and no money or real data moves.
# Stripe is the only live-wired adapter, and only in TEST mode: the app
# refuses any key that does not start with sk_test_ .
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Secret for the mock webhook endpoint (non-production only):
MOCK_WEBHOOK_SECRET="dev-webhook-secret"
# Credential references for providers that are catalogued in Settings >
# Integrations but have no live adapter yet (mock adapter serves them):
PLAID_SECRET=
TRANSUNION_API_KEY=
CHECKR_API_KEY=
RENTRANGE_API_KEY=
RENTOMETER_API_KEY=

# --- File storage ----------------------------------------------------------
# local (default, files under STORAGE_LOCAL_DIR) or s3 for any
# S3-compatible store (AWS S3, MinIO, ...). AWS_* names work as fallbacks.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
