generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
  OWNER
  TENANT
  ADMIN
}

enum PropertyType {
  SINGLE_UNIT
  MULTI_UNIT
}

enum UnitStatus {
  OCCUPIED
  VACANT
  TURNOVER
  ARCHIVED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED
  TERMINATED
}

enum ESignStatus {
  NOT_SENT
  SENT
  PARTIALLY_SIGNED
  SIGNED
  DECLINED
}

enum DocumentKind {
  LEASE
  ADDENDUM
  DISCLOSURE
  NOTICE
  INSPECTION
  ID
  PHOTO
  OTHER
}

enum LeaseEventKind {
  CREATED
  SENT
  SIGNED
  DECLINED
  COMPLETED
  RENEWED
  NOTICE_GIVEN
  NOTE
}

enum ChargeKind {
  RENT
  LATE_FEE
  DEPOSIT
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ProviderKind {
  PAYMENTS
  BANKING
  SCREENING
  COMPS
  EMAIL
}

enum ProviderConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ApplicationStatus {
  SUBMITTED
  SCREENING
  REVIEW
  APPROVED
  DECLINED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ExpenseCategory {
  TAXES
  INSURANCE
  REPAIRS
  MANAGEMENT
  UTILITIES
  OTHER
}

model Organization {
  id                  String               @id @default(cuid())
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  properties          Property[]
  units               Unit[]
  tenants             Tenant[]
  leases              Lease[]
  documents           Document[]
  charges             Charge[]
  payments            Payment[]
  maintenanceRequests MaintenanceRequest[]
  maintenancePhotos   MaintenancePhoto[]
  vendors             Vendor[]
  maintenanceEvents   MaintenanceEvent[]
  emailDeliveries     EmailDelivery[]
  providerConnections ProviderConnection[]
  webhookEvents       WebhookEvent[]
  paymentMethods      PaymentMethod[]
  autopaySettings     AutopaySetting[]
  payouts             Payout[]
  applications        Application[]
  screeningConsents   ScreeningConsent[]
  screeningReports    ScreeningReport[]
  tenantNotes         TenantNote[]
  leaseEvents         LeaseEvent[]
  expenses            Expense[]
}

model User {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email             String
  name              String
  phone             String?
  passwordHash      String?
  role              UserRole
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ownedProperties   Property[]         @relation("PropertyOwner")
  tenant            Tenant?
  maintenanceEvents MaintenanceEvent[]
  emailNotificationsEnabled Boolean @default(true)

  @@unique([organizationId, email])
  @@unique([id, organizationId])
  @@index([organizationId, role])
}

model Property {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId             String?
  owner               User?                @relation("PropertyOwner", fields: [ownerId, organizationId], references: [id, organizationId])
  name                String
  type                PropertyType
  street              String
  city                String
  state               String
  postalCode          String
  yearBuilt           Int?
  purchasePrice       Decimal?             @db.Decimal(12, 2)
  downPayment         Decimal?             @db.Decimal(12, 2)
  loanAmount          Decimal?             @db.Decimal(12, 2)
  annualDebtService   Decimal              @default(0) @db.Decimal(12, 2)
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  units               Unit[]
  documents           Document[]
  maintenanceRequests MaintenanceRequest[]
  payouts             Payout[]
  expenses            Expense[]

  @@unique([id, organizationId])
  @@index([organizationId, archivedAt])
  @@index([organizationId, ownerId])
}

model Unit {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId          String
  property            Property             @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  number              String
  isImplicit          Boolean              @default(false)
  bedrooms            Int?
  bathrooms           Decimal?             @db.Decimal(3, 1)
  squareFeet          Int?
  listedRent          Decimal?             @db.Decimal(12, 2)
  marketRent          Decimal?             @db.Decimal(12, 2)
  marketRentSetById   String?
  marketRentSetByName String?
  marketRentSetAt     DateTime?
  floor               Int?
  amenities           String[]             @default([])
  status              UnitStatus           @default(VACANT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  leases              Lease[]
  documents           Document[]
  maintenanceRequests MaintenanceRequest[]
  applications        Application[]

  @@unique([propertyId, number])
  @@unique([id, organizationId])
  @@unique([id, propertyId, organizationId])
  @@index([organizationId, status])
}

model Tenant {
  id                           String               @id @default(cuid())
  organizationId               String
  organization                 Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId                       String?
  user                         User?                @relation(fields: [userId, organizationId], references: [id, organizationId])
  name                         String
  email                        String?
  phone                        String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  notes                        TenantNote[]
  leaseEvents                  LeaseEvent[]
  leases                       LeaseTenant[]
  paymentMethods               PaymentMethod[]
  autopaySettings              AutopaySetting[]
  maintenanceRequests          MaintenanceRequest[]

  @@unique([id, organizationId])
  @@unique([userId, organizationId])
  @@index([organizationId, name])
}

model Lease {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit             @relation(fields: [unitId, organizationId], references: [id, organizationId])
  startDate       DateTime         @db.Date
  endDate         DateTime         @db.Date
  monthlyRent     Decimal          @db.Decimal(12, 2)
  deposit         Decimal          @db.Decimal(12, 2)
  lateFee         Decimal          @default(0) @db.Decimal(12, 2)
  graceDays       Int              @default(0)
  rentDueDay      Int              @default(1)
  prorateFirstMonth Boolean        @default(true)
  moveInFee       Decimal          @default(0) @db.Decimal(12, 2)
  petDeposit      Decimal          @default(0) @db.Decimal(12, 2)
  status          LeaseStatus      @default(DRAFT)
  eSignStatus     ESignStatus      @default(NOT_SENT)
  signedAt        DateTime?
  occupants       String?
  noticeGivenAt   DateTime?        @db.Date
  moveOutDate     DateTime?        @db.Date
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  events          LeaseEvent[]
  tenants         LeaseTenant[]
  documents       Document[]
  charges         Charge[]
  payments        Payment[]
  autopaySettings AutopaySetting[]
  draft           LeaseDraft?

  @@unique([id, organizationId])
  @@index([organizationId, unitId, status])
  @@index([organizationId, endDate])
}

/// Wizard state for a DRAFT lease: the step to resume on and the fields the lease row cannot hold.
model LeaseDraft {
  leaseId        String   @id
  organizationId String
  lease          Lease    @relation(fields: [leaseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  step           Int      @default(0)
  furthestStep   Int      @default(0)
  data           Json
  updatedAt      DateTime @updatedAt

  @@unique([leaseId, organizationId])
  @@index([organizationId])
}

model LeaseTenant {
  leaseId        String
  tenantId       String
  organizationId String
  lease          Lease   @relation(fields: [leaseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tenant         Tenant  @relation(fields: [tenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  isPrimary      Boolean @default(false)

  @@id([leaseId, tenantId])
  @@index([organizationId, tenantId])
}

// SQL migration requires exactly one of leaseId, propertyId or unitId.
model Document {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaseId          String?
  lease            Lease?            @relation(fields: [leaseId, organizationId], references: [id, organizationId])
  propertyId       String?
  property         Property?         @relation(fields: [propertyId, organizationId], references: [id, organizationId])
  unitId           String?
  unit             Unit?             @relation(fields: [unitId, organizationId], references: [id, organizationId])
  kind             DocumentKind
  name             String
  storageKey       String            @unique
  sizeBytes        BigInt
  mimeType         String
  isCover          Boolean           @default(false)
  sortOrder        Int?
  caption          String?
  createdAt        DateTime          @default(now())
  maintenancePhoto MaintenancePhoto?

  @@index([organizationId, leaseId])
  @@index([organizationId, propertyId])
  @@index([organizationId, unitId])
}

model TenantNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorName     String
  body           String
  createdAt      DateTime     @default(now())

  @@index([organizationId, tenantId, createdAt])
}

// Per-signer e-sign events and other lease activity shown on the lease detail screen.
model LeaseEvent {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaseId        String
  lease          Lease          @relation(fields: [leaseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  kind           LeaseEventKind
  tenantId       String?
  tenant         Tenant?        @relation(fields: [tenantId, organizationId], references: [id, organizationId])
  actorName      String?
  message        String?
  createdAt      DateTime       @default(now())

  @@index([organizationId, leaseId, createdAt])
}

model Charge {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaseId        String
  lease          Lease        @relation(fields: [leaseId, organizationId], references: [id, organizationId])
  kind           ChargeKind
  amount         Decimal      @db.Decimal(12, 2)
  dueDate        DateTime     @db.Date
  description    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, leaseId, dueDate])
}

model Payment {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaseId           String
  lease             Lease         @relation(fields: [leaseId, organizationId], references: [id, organizationId])
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  providerReference String?       @unique
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  @@index([organizationId, leaseId, createdAt])
}

model MaintenanceRequest {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property            @relation(fields: [propertyId, organizationId], references: [id, organizationId])
  unitId         String
  unit           Unit                @relation(fields: [unitId, propertyId, organizationId], references: [id, propertyId, organizationId])
  title          String
  description    String?
  priority       MaintenancePriority @default(NORMAL)
  status         MaintenanceStatus   @default(NEW)
  vendorName     String?
  vendorId       String?
  vendor         Vendor?             @relation(fields: [vendorId, organizationId], references: [id, organizationId])
  tenantId       String?
  tenant         Tenant?             @relation(fields: [tenantId, organizationId], references: [id, organizationId])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  completedAt    DateTime?
  photos         MaintenancePhoto[]
  events         MaintenanceEvent[]

  @@unique([id, organizationId])
  @@index([organizationId, status, priority])
  @@index([organizationId, unitId])
}

model MaintenancePhoto {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  maintenanceRequestId String
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId, organizationId], references: [id, organizationId], onDelete: Cascade)
  storageKey           String             @unique
  sizeBytes            BigInt
  mimeType             String
  documentId           String?            @unique
  document             Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())

  @@index([organizationId, maintenanceRequestId])
}

model Vendor {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  trade          String?
  email          String?
  phone          String?
  requests       MaintenanceRequest[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

model MaintenanceEvent {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  maintenanceRequestId String
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actorId              String?
  actor                User?              @relation(fields: [actorId, organizationId], references: [id, organizationId])
  kind                 String
  body                 String?
  fromStatus           MaintenanceStatus?
  toStatus             MaintenanceStatus?
  createdAt            DateTime           @default(now())

  @@index([organizationId, maintenanceRequestId, createdAt])
}

// The mock email outbox also enforces one delivery per event and recipient.
model EmailDelivery {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventKey       String
  kind           String
  recipient      String
  subject        String
  body           String
  provider       String       @default("mock")
  sentAt         DateTime     @default(now())

  @@unique([organizationId, eventKey, recipient])
  @@index([organizationId, sentAt])
}

// settings contain non-secret connection metadata only. Credentials belong in environment variables.
model ProviderConnection {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           ProviderKind
  provider       String
  status         ProviderConnectionStatus @default(DISCONNECTED)
  settings       Json                     @default("{}")
  lastSyncAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([organizationId, kind, provider])
  @@index([organizationId, status])
}

model WebhookEvent {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider        String
  externalEventId String
  eventType       String
  payloadHash     String
  receivedAt      DateTime     @default(now())

  @@unique([provider, externalEventId])
  @@index([organizationId, receivedAt])
}

// Only provider-issued tokens and display metadata; never card or bank account numbers.
model PaymentMethod {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  provider        String
  providerToken   String
  type            String
  last4           String?
  brand           String?
  createdAt       DateTime         @default(now())
  autopaySettings AutopaySetting[]

  @@unique([id, organizationId])
  @@unique([provider, providerToken])
  @@index([organizationId, tenantId])
}

model AutopaySetting {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaseId         String
  lease           Lease         @relation(fields: [leaseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId, organizationId], references: [id, organizationId], onDelete: Cascade)
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId, organizationId], references: [id, organizationId])
  enabled         Boolean       @default(false)
  dayOfMonth      Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([leaseId, tenantId])
  @@index([organizationId, enabled])
}

model Payout {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId        String?
  property          Property?    @relation(fields: [propertyId, organizationId], references: [id, organizationId])
  month             String?      @db.VarChar(7)
  provider          String
  providerReference String?      @unique
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("usd")
  status            String
  arrivalDate       DateTime?
  createdAt         DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, propertyId, month])
}

model Application {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitId         String
  unit           Unit               @relation(fields: [unitId, organizationId], references: [id, organizationId])
  applicantName  String
  applicantEmail String
  status         ApplicationStatus  @default(SUBMITTED)
  decisionReason String?
  decidedBy      String?
  decidedAt      DateTime?
  appliedAt      DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  consents       ScreeningConsent[]
  reports        ScreeningReport[]

  @@unique([id, organizationId])
  @@index([organizationId, status, appliedAt])
}

model ScreeningConsent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application  @relation(fields: [applicationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  provider       String
  consentedAt    DateTime
  consentVersion String
  revokedAt      DateTime?

  @@unique([applicationId, provider])
  @@index([organizationId, consentedAt])
}

model ScreeningReport {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId     String
  application       Application  @relation(fields: [applicationId, organizationId], references: [id, organizationId], onDelete: Cascade)
  provider          String
  providerReference String
  status            String
  summary           Json? // Only approved summary fields; full reports remain with the provider.
  completedAt       DateTime?
  createdAt         DateTime     @default(now())

  @@unique([provider, providerReference])
  @@index([organizationId, applicationId])
}

model Expense {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property        @relation(fields: [propertyId, organizationId], references: [id, organizationId], onDelete: Cascade)
  category       ExpenseCategory
  amount         Decimal         @db.Decimal(12, 2)
  occurredOn     DateTime        @db.Date
  description    String?
  vendor         String?
  createdAt      DateTime        @default(now())

  @@unique([id, organizationId])
  @@index([organizationId, propertyId, occurredOn])
  @@index([organizationId, category, occurredOn])
}
