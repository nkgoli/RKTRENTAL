{
  "name": "rocketrental",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "demo:seed": "node --env-file-if-exists=.env --import ./prisma/os-userinfo.mjs node_modules/tsx/dist/cli.mjs scripts/demo-seed/index.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate deploy",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import ./prisma/os-userinfo.mjs node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:local": "npm install --prefix prisma && npm run db:local --prefix prisma",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "node scripts/db-reset.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
